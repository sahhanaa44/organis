# =============================================================================
# Organis — root environment reference
# =============================================================================
# Each service loads its own .env file (server/.env, client/.env,
# ai-service/.env) — copy the matching .env.example in each folder rather
# than this file. This root copy exists as a single reference of every
# variable used across the stack.
# =============================================================================

# ---- server/.env --------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://:@organis.82kruri.mongodb.net/?appName=organis
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=.apps.googleusercontent.com
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=

# ---- client/.env ----------------------------------------------------------
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=

# ---- ai-service/.env -------------------------------------------------------
HOST=0.0.0.0
PORT=8000
