# === Organis / client (React + Vite) ===
# All VITE_-prefixed variables are bundled into the client build and are
# therefore public. Never put secrets here — the Anthropic key, Mongo URI,
# and JWT secret all live only in server/.env.

# Base URL the client calls for the Node API.
# Leave as /api to use Vite's dev proxy to http://localhost:5000 (see vite.config.js).
VITE_API_URL=/api

# Google OAuth client ID (same value as the server's GOOGLE_CLIENT_ID).
# If left blank, the login page falls back to email/password only.
VITE_GOOGLE_CLIENT_ID=59007266186-hkgvjj4ai82qfut9fcdjvchm04pjtv8d.apps.googleusercontent.com
