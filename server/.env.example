# === Organis / server (Node + Express) ===

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/organis

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Internal AI service
AI_SERVICE_URL=http://localhost:8000

# Organis Assistant — optional. If unset, the assistant runs in local/demo
# mode using a built-in knowledge base instead of calling an LLM API.
# Never expose this key to the React client.
ANTHROPIC_API_KEY=
